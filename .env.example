# ConjureOS Fitness — frontend env (Vite exposes VITE_-prefixed vars to the
# browser as import.meta.env.VITE_*). Copy to `.env.local`.
#
# LEAVE EVERYTHING BLANK to run in DEMO MODE — the app uses an in-browser mock
# backend (seeded data + offline AI estimates), so `npm install && npm run dev`
# works with no server. This is the default contributor experience.
#
# To run against the real (closed) ConjureOS backend, fill in the SAME Supabase
# project as ConjureOS. The anon key is safe to expose; RLS enforces per-user
# access. The Anthropic key is NOT here — it lives server-side in the Edge
# Function.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Force demo mode even when the Supabase vars above are set. Useful for working
# on the UI without touching real data. Anything other than "true" is ignored.
VITE_USE_MOCK=
