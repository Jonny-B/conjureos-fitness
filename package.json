{
  "name": "conjureos-fitness",
  "version": "0.6.1",
  "description": "Conjure Health: plans, daily check-off, calorie + nutrition logging, weight, and an AI-guided workout coach for ConjureOS.",
  "type": "module",
  "license": "MIT",
  "author": "Jonny-B",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jonny-B/conjureos-fitness.git"
  },
  "conjureos": {
    "displayName": "Conjure Health",
    "icon": "fa:apple-whole",
    "permissions": [
      "ai.complete",
      "vfs.read",
      "vfs.write",
      "actions.read",
      "actions.write"
    ],
    "actions": {
      "logFood": {
        "permission": "actions.write",
        "description": "Log a food to the user's diary for a given meal and date. Only the food name is required: if calories (and protein/carbs/fat, in grams) are omitted, the app estimates them from the name and a typical serving and records them as adjustable estimates. So an assistant can log a named food like \"a McCrispy sandwich\" without knowing the numbers. Also accepts meal (breakfast|lunch|dinner|snacks) and date (YYYY-MM-DD, defaults to today). Pass calories only when the user states an explicit number.",
        "params": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "maxLength": 80 },
            "calories": { "type": "integer", "minimum": 0, "maximum": 5000 },
            "protein": { "type": "integer", "minimum": 0, "maximum": 500, "description": "Grams." },
            "carbs": { "type": "integer", "minimum": 0, "maximum": 800, "description": "Grams." },
            "fat": { "type": "integer", "minimum": 0, "maximum": 500, "description": "Grams." },
            "meal": { "type": "string", "enum": ["breakfast", "lunch", "dinner", "snacks"], "description": "Defaults by time of day when omitted." },
            "date": { "type": "string", "description": "YYYY-MM-DD; defaults to today." }
          },
          "required": ["name"]
        },
        "returns": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "description": "The new diary entry's id." }
          }
        }
      },
      "todayTotals": {
        "permission": "actions.read",
        "description": "Return today's nutrition totals (calories, protein, carbs, fat) and the user's daily goals plus remaining calories. Useful for dashboards, assistants, or apps that want to know how much budget is left.",
        "params": {
          "type": "object",
          "properties": {}
        },
        "returns": {
          "type": "object",
          "properties": {
            "date": { "type": "string", "description": "YYYY-MM-DD." },
            "total": {
              "type": "object",
              "properties": {
                "calories": { "type": "number" },
                "protein": { "type": "number" },
                "carbs": { "type": "number" },
                "fat": { "type": "number" }
              }
            },
            "goals": {
              "type": "object",
              "properties": {
                "calories": { "type": "number" },
                "protein": { "type": "number" },
                "carbs": { "type": "number" },
                "fat": { "type": "number" }
              }
            },
            "caloriesRemaining": { "type": "number" }
          }
        }
      },
      "logRecipeMeal": {
        "permission": "actions.write",
        "description": "Log a saved recipe from the Recipes app as a meal by slug, copying its per-serving nutrition into the diary and marking the recipe cooked. Takes slug, optional servings (default 1), meal, and date.",
        "params": {
          "type": "object",
          "properties": {
            "slug": { "type": "string", "maxLength": 80, "description": "The Recipes app slug of the saved recipe." },
            "servings": { "type": "number", "minimum": 0.1, "maximum": 20, "description": "Defaults to 1." },
            "meal": { "type": "string", "enum": ["breakfast", "lunch", "dinner", "snacks"], "description": "Defaults by time of day when omitted." },
            "date": { "type": "string", "description": "YYYY-MM-DD; defaults to today." }
          },
          "required": ["slug"]
        },
        "returns": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "description": "The new diary entry's id." },
            "logged": { "type": "boolean" }
          }
        }
      }
    },
    "promptSuggestions": [
      "Log a chicken sandwich and a beer for lunch",
      "How many calories do I have left today?",
      "Log the recipe I cooked tonight"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:inline": "tsc -b && vite build --mode inline",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@conjureos/ui": "^0.1.1",
    "barcode-detector": "^3.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
